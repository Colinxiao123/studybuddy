# ============================================================
#  错题本应用配置  →  复制为 app/.env 后填写
# ============================================================

# ---------- 视觉（识图）模型 ----------
# provider 取值：deepseek / openai / ollama / mock
#   mock = 离线样例模式，不联网，用于先跑通界面
VISION_PROVIDER=deepseek
VISION_API_BASE=https://api.deepseek.com/v1
VISION_API_KEY=
# ↓↓↓ 填你在 DeepSeek 控制台看到的「识图模型」名称 ↓↓↓
VISION_MODEL=deepseek-flash
VISION_TIMEOUT=180

# ---------- 性能与规模 ----------
# 推理型模型会把大量 token 花在思考上，预算给小了会出现「返回成功但内容是空的」。
API_MAX_TOKENS=8192
# PDF 单次处理页数上限（<=0 不限）。PDF 是按页分别识别的，
# 所以这个值只影响耗时，不会影响上下文长度；但设小了会漏掉后面的页。
VISION_MAX_PAGES=50
# 多页并发识别的线程数（纯 I/O 等待，并发能成倍缩短总耗时）
VISION_CONCURRENCY=4

# ---------- 文本模型（知识点抽取 / 错因分析 / AI 对话）----------
# 留空则复用上面的凭据
TEXT_API_BASE=
TEXT_API_KEY=
TEXT_MODEL=deepseek-flash

# ---------- 本地 Ollama 示例（完全离线、数据不出本机）----------
# VISION_PROVIDER=ollama
# VISION_API_BASE=http://127.0.0.1:11434/v1
# VISION_API_KEY=ollama
