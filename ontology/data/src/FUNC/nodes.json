    "node_type": "KnowledgePoint",
    "name": "函数的单调性",
    "aliases": ["单调性", "增函数", "减函数", "严格增", "严格减", "单调区间", "monotonicity"],
    "kp_type": "concept",
    "module": "FUNC",
    "section_id": "SEC-BX1-05-02",
    "sub_section_id": null,
    "difficulty": 3,
    "importance": "master",
